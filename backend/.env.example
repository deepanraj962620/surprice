# ===== Server =====
PORT=3001
FRONTEND_URL=http://localhost:3000

# ===== Supabase (for JWT verification of admin endpoints) =====
# Your Supabase project URL
SUPABASE_URL=https://rryixlgtukxznlojrjee.supabase.co

# Publishable (anon) key — safe to expose in frontend
SUPABASE_PUBLISHABLE_KEY=sb_publishable_you_rpublishable_key_here

# Secret (service role) key — server-only, NEVER expose to frontend
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# JWKS URL for verifying user JWTs
SUPABASE_JWKS_URL=https://rryixlgtukxznlojrjee.supabase.co/auth/v1/.well-known/jwks.json

# ===== Optional: Supabase Postgres (replaces SQLite) =====
# If your DB password contains special characters, percent-encode them.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.rryixlgtukxznlojrjee.supabase.co:5432/postgres
